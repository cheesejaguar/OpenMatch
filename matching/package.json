{
  "name": "@openmatch/matching",
  "version": "1.0.0",
  "description": "Open-source, auditable matching algorithm for OpenMatch.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": "./algorithm_config.json"
  },
  "files": [
    "dist",
    "algorithm_config.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^6.0.3",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
