{
  "name": "openmatch",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source iOS dating app with an auditable matching algorithm and no paid dating advantage.",
  "license": "Apache-2.0",
  "workspaces": [
    "matching",
    "backend",
    "admin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "license-inventory": "node scripts/license-inventory.mjs",
    "gen:logo": "node scripts/gen_logo.mjs",
    "gen:sdk": "node scripts/gen-sdk.mjs",
    "rebrand": "node scripts/rebrand.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  },
  "//": "SEV-N12 — overrides[] force-pins transitive deps with known high/critical advisories to patched versions so the npm-audit gate can run at --audit-level=high without waiting on upstream majors of @vercel/node, @parse/node-apn, etc.",
  "overrides": {
    "node-forge": "^1.4.0",
    "path-to-regexp": "^6.3.0",
    "undici": "^6.28.0",
    "esbuild": "^0.25.0",
    "ajv": "^8.17.1",
    "ws": "^8.20.1",
    "tar": "^7.5.21",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.28",
    "@hono/node-server": "^1.19.13",
    "vite": "^7.3.6",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
