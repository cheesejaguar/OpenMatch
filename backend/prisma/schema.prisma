  active
  paused
  banned
  deleted
}

enum VisibilityStatus {
  visible
  hidden
}

enum ModerationStatus {
  clean
  reviewed_ok
  under_review
  restricted
  removed
}

enum Gender {
  Woman
  Man
  NonBinary
  TransWoman
  TransMan
  Genderqueer
  Agender
  Questioning
  SelfDescribe
  PreferNotToSay
}

enum RelationshipGoal {
  LongTerm
  LifePartner
  ShortTerm
  Casual
  Friendship
  Figuring
  Marriage
  NonMono
  Open
}

enum LikesVisibility {
  visible
  count_only
  hidden
}

enum Handedness {
  right
  left
  center
}

enum SwipeDecision {
