// -------- User & profile --------

model User {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  status        AccountStatus @default(active)
  dateOfBirth   DateTime
  emailHash     String?       @unique
  phoneHash     String?       @unique
  authProvider  AuthProvider
  authSubject   String?       @unique // Apple subject or magic-link identity
  isAgeVerified Boolean       @default(false)
  isBanned      Boolean       @default(false)
  deletedAt     DateTime?

  profile              Profile?
  preferences          Preferences?
  swipesMade           SwipeAction[]            @relation("SwipeViewer")
  swipesReceived       SwipeAction[]            @relation("SwipeTarget")
  likesSent            Like[]                   @relation("LikeFrom")
  likesReceived        Like[]                   @relation("LikeTo")
  matchesA             Match[]                  @relation("MatchUserA")
  matchesB             Match[]                  @relation("MatchUserB")
  unmatchedBy          Match[]                  @relation("MatchUnmatcher")
  blocksMade           Block[]                  @relation("Blocker")
  blocksReceived       Block[]                  @relation("Blocked")
  reportsMade          Report[]                 @relation("Reporter")
  reportsAbout         Report[]                 @relation("Reported")
  messagesSent         Message[]
  sessions             Session[]
  authChallenges       AuthChallenge[]
  deviceTokens         DeviceToken[]
  bans                 UserBan[]
  appeals              Appeal[]
  consents             ConsentRecord[]
  dsarRequests         DataSubjectRequest[]
  deletionRequests     AccountDeletionRequest[]
  scamSignals          ScamSignal[]
  notificationPrefs    NotificationPreference?
  sanctionsScreenings  SanctionsScreening[]
  scammerNotices       ScammerNotification[]    @relation("ScammerNoticeRecipient")
  noticeReportsAbout   NoticeAndActionReport[]  @relation("NoticeAndActionTarget")
  betaRedemption       BetaInviteRedemption?
  notificationDevices  NotificationDevice[]
  analyticsEvents      AnalyticsEvent[]
  betaFeedback         BetaFeedback[]
  pushDeliveryLogs     PushDeliveryLog[]
  deckImpressionsMade  DeckImpression[]         @relation("DeckImpressionViewer")
  deckImpressionsAbout DeckImpression[]         @relation("DeckImpressionTarget")
  verificationRequests VerificationRequest[]
  moderationFlags      ModerationFlag[]         @relation("ModerationFlagTarget")
  dateFeedbackGiven    DateFeedback[]           @relation("DateFeedbackFrom")
  dateFeedbackReceived DateFeedback[]           @relation("DateFeedbackAbout")

  @@index([status])
  // PERF-B14 — daily-digest counts new signups in a time window
  @@index([createdAt])
}

model Profile {
  id                    String                                 @id @default(cuid())
  userId                String                                 @unique
  user                  User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String
  bio                   String                                 @default("")
  gender                Gender
  pronouns              String?
  ageDisplayEnabled     Boolean                                @default(true)
  // Location precision retained internally; only ever surfaced via the
  // formatDistance helper. We store both PostGIS geography (for queries)
  // and the rounded city for display.
  location              Unsupported("geography(Point, 4326)")?
  city                  String?
  region                String?
  country               String?
  heightCm              Int?
  educationLevel        String?
  college               String?
  jobTitle              String?
  companyDisplayEnabled Boolean                                @default(false)
  company               String?
  relationshipGoal      RelationshipGoal?
  childrenStatus        String?
  familyPlans           String?
  drinking              String?
  smoking               String?
  cannabis              String?
  exercise              String?
  diet                  String?
  religion              String?
  politics              String?
  languages             String[]                               @default([])
  interests             String[]                               @default([])
  // Selected core values (keys from the curated values catalog, see
  // matching/src/content). Powers values-overlap scoring (#6) and the
  // "you both value …" card explanation. Distinct from free-form interests.
  values                String[]                               @default([])
  verificationStatus    String                                 @default("unverified")
  // Trust & safety automation — set by an admin when they approve a
  // selfie-pose verification request. The iOS deck renders a small
  // "✓ verified" badge when this is true. Independent of
  // `verificationStatus` (which is a free-form column used by older
  // surfaces) so a single admin action can update both atomically.
  isPhotoVerified       Boolean                                @default(false)
  visibilityStatus      VisibilityStatus                       @default(visible)
  moderationStatus      ModerationStatus                       @default(clean)
  prompts               Json?
  lastActiveAt          DateTime                               @default(now())
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt

  photos ProfilePhoto[]

  @@index([visibilityStatus, moderationStatus])
  @@index([city])
}

model ProfilePhoto {
  id               String           @id @default(cuid())
  profileId        String
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storageKey       String
  cdnUrl           String
  sortOrder        Int
  moderationStatus ModerationStatus @default(clean)
  width            Int?
  height           Int?
  blurhash         String?
  // Trust & safety automation — set by the iOS on-device NSFW
  // pre-check (Vision VNClassifyImageRequest) when the classifier
  // produced an `flag` (not `block`) decision. The server still re-runs
  // its own moderation pass; this is a hint that the upload is worth
  // surfacing earlier in the admin queue.
  clientFlaggedAt  DateTime?
  // Free-form scan reasons attached by the client and/or the server
  // moderator. Each entry is `{ source, code, score? }`. Surfaced in
  // the admin queue so operators see *why* a photo is in the queue
  // without opening it.
  scanReasons      Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([profileId, sortOrder])
  // PERF-B14 — daily-digest counts photo uploads in a time window
  @@index([createdAt])
}

model Preferences {
  id                              String             @id @default(cuid())
  userId                          String             @unique
  user                            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge                          Int                @default(18)
  maxAge                          Int                @default(99)
  maxDistanceKm                   Int                @default(40)
  interestedGenders               Gender[]           @default([])
  relationshipGoals               RelationshipGoal[] @default([])
  heightMinCm                     Int?
  heightMaxCm                     Int?
  educationLevels                 String[]           @default([])
  colleges                        String[]           @default([])
  lifestyleFilters                Json?
  includeUnansweredOptionalFields Boolean            @default(true)
  hardFilters                     Json?
  softPreferences                 Json?
  excludeIncompatibleGoals        Boolean            @default(false)
  likesVisibility                 LikesVisibility    @default(visible)
  discoveryPaused                 Boolean            @default(false)
  handedness                      Handedness         @default(right)
  // User-selected matching preset key (see MatchingPreset.key). Null means
  // "use the catalog default". Validated against enabled presets on write;
  // discovery falls back to the default if the selection is gone/disabled.
  discoveryPresetKey              String?
  // Trust filter (#8): when true, discovery only surfaces photo-verified
  // candidates. Default off so the pool isn't silently shrunk.
  verifiedOnly                    Boolean            @default(false)
  // Intentional-dating "focus mode" (#10): when true the deck is quieted so
  // the user concentrates on existing conversations. Distinct from
  // discoveryPaused (a hard user-initiated pause); focusMode can be toggled
  // automatically/seasonally and is advisory.
  focusMode                       Boolean            @default(false)
  // Dealbreakers captured at onboarding (#5): catalog keys the user will not
  // compromise on (e.g. "wants_kids", "non_smoker"). Stored for intent
  // capture and surfaced; soft-applied in ranking, not a hard gate.
  dealbreakers                    String[]           @default([])
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
}

// -------- Swipe / like / match --------

model SwipeAction {
  id                   String        @id @default(cuid())
  viewerUserId         String
  viewer               User          @relation("SwipeViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  targetUserId         String
  target               User          @relation("SwipeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  decision             SwipeDecision
  algorithmVersion     String
  rankingConfigVersion String
  deckSessionId        String
  createdAt            DateTime      @default(now())
  undoneAt             DateTime?

  @@index([viewerUserId, targetUserId])
  @@index([targetUserId, decision])
  // PERF-B2 — discovery.buildDeck pulls the most recent priorSwipes for
  // a viewer (bounded window + take cap). Without this composite the
  // planner did a per-row sort over every row matching viewerUserId; the
  // (viewerUserId, createdAt DESC) ordering lets PG stream rows in index
  // order and stop at the LIMIT.
  @@index([viewerUserId, createdAt(sort: Desc)])
}

// DISC-Q1 — anti-staleness in the deck. Each row records a (viewer,
// target) pair that appeared on a deck page so the next page can skip
// cards the viewer has already seen but not acted on. `shownAt` is
// indexed so the trailing-7-days lookup is index-supported; the daily
// prune worker deletes rows older than 30 days.
model DeckImpression {
  id            String   @id @default(cuid())
  viewerUserId  String
  viewer        User     @relation("DeckImpressionViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  targetUserId  String
  target        User     @relation("DeckImpressionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  deckSessionId String
  shownAt       DateTime @default(now())

  @@index([viewerUserId, shownAt(sort: Desc)])
  @@index([shownAt])
}

model Like {
  id          String     @id @default(cuid())
  fromUserId  String
  from        User       @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  to          User       @relation("LikeTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status      LikeStatus @default(active)
  createdAt   DateTime   @default(now())
  withdrawnAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  // listIncomingLikes orders by createdAt DESC — composite lets PG skip sort
  @@index([toUserId, status, createdAt(sort: Desc)])
  // listOutgoingLikes / DSAR exports filter on (fromUserId, status)
  @@index([fromUserId, status])
}

model Match {
  id                String        @id @default(cuid())
  userAId           String
  userA             User          @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId           String
  userB             User          @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  unmatchedAt       DateTime?
  unmatchedByUserId String?
  unmatchedBy       User?         @relation("MatchUnmatcher", fields: [unmatchedByUserId], references: [id])
  status            MatchStatus   @default(active)
  conversation      Conversation?
  dateFeedbacks     DateFeedback[]

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  // listMatches orders by createdAt DESC — composite lets PG skip sort
  @@index([userAId, status, createdAt(sort: Desc)])
  @@index([userBId, status, createdAt(sort: Desc)])
  // PERF-B14 — daily-digest counts new matches in a time window
  @@index([createdAt])
}

// Post-match / post-date feedback (#1 outcome loop + #11 two-sided feedback).
// One row per (match, author). Private — never shown to the other person.
// Feeds two consumers: (a) safety, when respectful=false or matchedProfile=
// false (deception/bad-actor signal into the moderation pipeline); and (b)
// matching, where met/wantToContinue rates per user inform desirability and
// response-quality aggregates. `met` gates the optional quality fields.
model DateFeedback {
  id             String   @id @default(cuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fromUserId     String
  from           User     @relation("DateFeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  aboutUserId    String
  about          User     @relation("DateFeedbackAbout", fields: [aboutUserId], references: [id], onDelete: Cascade)
  met            Boolean  @default(false)
  wantToContinue Boolean?
  respectful     Boolean?
  matchedProfile Boolean?
  note           String?
  createdAt      DateTime @default(now())

  @@unique([matchId, fromUserId])
  @@index([aboutUserId])
  @@index([createdAt])
}

model Conversation {
  id        String             @id @default(cuid())
  matchId   String             @unique
  match     Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  status    ConversationStatus @default(active)
  // Responsiveness / anti-ghosting (#7): who sent the last message and when,
  // so we can compute whose "turn" it is and nudge the non-responder.
  // Maintained on each message send.
  lastMessageAt           DateTime?
  lastMessageSenderUserId String?

  messages Message[]
}

model Message {
  id               String           @id @default(cuid())
  conversationId   String
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId     String
  sender           User             @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body             String
  createdAt        DateTime         @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
  deletedAt        DateTime?
  moderationStatus ModerationStatus @default(clean)
  // Voice-note payload. Both columns are nullable so a text-only message
  // remains the default shape. When `audioPath` is set, `body` is the
  // empty string (or a short summary "[voice note]") for back-compat
  // with clients that don't render audio yet. Moderation of speech-to-
  // text content is a Trust & Safety lane TODO — see CoreML / cloud STT
  // pipeline notes in doc/safety.
  audioPath        String?
  // Full URL to fetch the audio bytes from. In production this is the
  // Vercel Blob URL (treated as a server-only secret — never returned
  // to clients; the /audio/serve proxy uses it to stream bytes). In
  // local dev this is the `/media/...` filesystem-backed path.
  audioCdnUrl      String?
  audioDurationMs  Int?

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
}

// Emoji reactions on messages. (messageId, userId, emoji) is unique so
// repeated taps on the same emoji are idempotent and a user can only
// hold one reaction-of-a-given-emoji per message. A user CAN attach
// multiple distinct emojis to the same message.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// -------- Safety --------

model Block {
  id            String   @id @default(cuid())
  blockerUserId String
  blocker       User     @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String
  blocked       User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model Report {
  id                  String              @id @default(cuid())
  reporterUserId      String
  reporter            User                @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUserId      String
  reported            User                @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedProfileId   String?
  reportedMessageId   String?
  reason              String
  details             String?
  status              ReportStatus        @default(open)
  createdAt           DateTime            @default(now())
  resolvedAt          DateTime?
  moderatorId         String?
  resolution          ModerationDecision?
  assignedAdminUserId String?
  assignedAdmin       AdminUser?          @relation("ReportAssignee", fields: [assignedAdminUserId], references: [id])

  moderationActions ModerationAction[]
  notes             AdminNote[]

  @@index([status, createdAt])
  @@index([assignedAdminUserId])
  // Admin investigation: "all reports against this user" / "user's report history"
  @@index([reportedUserId])
  @@index([reporterUserId])
  // PERF-B14 — daily-digest counts new reports in a time window with no status filter
  @@index([createdAt])
}

// -------- Auth --------

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model AuthChallenge {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String?
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  // SEV-A14 — per-challenge failed-attempt counter. After 5 wrong
  // tokens the challenge is marked consumed so a leaked challengeId
  // (referer, server log, etc.) can no longer be brute-forced via a
  // rotating proxy pool that bypasses the per-IP rate limit.
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

// -------- Transparency --------

model AlgorithmAuditRecord {
  id                   String   @id @default(cuid())
  algorithmVersion     String
  rankingConfigVersion String
  changedBy            String
  changeSummary        String
  publicChangelogUrl   String?
  createdAt            DateTime @default(now())

  @@index([createdAt])
}

// -------- Admin / moderation --------

model AdminUser {
  id                      String          @id @default(cuid())
  email                   String          @unique
  displayName             String
  identityProviderSubject String?         @unique
  status                  AdminUserStatus @default(active)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  lastLoginAt             DateTime?

  // TOTP 2FA. `totpSecret` is the base32-encoded secret stored after
  // enrolment. `recoveryCodes` holds SHA-256 hashes (hex) of one-time
  // recovery codes; the plaintext is shown to the operator only once
  // at enrolment. `twoFactorRequired` lets per-user policy override the
  // global ADMIN_2FA_OPTIONAL env flag (default: required).
  totpSecret        String?
  totpEnrolledAt    DateTime?
  recoveryCodes     String[]  @default([])
  twoFactorRequired Boolean   @default(true)

  roles             AdminUserRole[]        @relation("RoleHolder")
  rolesAssigned     AdminUserRole[]        @relation("RoleAssigner")
  sessions          AdminSession[]
  authChallenges    AdminAuthChallenge[]
  auditEvents       AdminAuditLog[]        @relation("AuditActor")
  moderationActions ModerationAction[]
  bansIssued        UserBan[]              @relation("BanIssuer")
  unbansIssued      UserBan[]              @relation("UnbanIssuer")
  notes             AdminNote[]
  accessGrants      SensitiveAccessGrant[]
  assignedReports   Report[]               @relation("ReportAssignee")
  appealsDecided    Appeal[]               @relation("AppealDecider")
  betaInvites       BetaInviteCode[]

  @@index([status])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members AdminUserRole[]
}

model AdminUserRole {
  adminUserId           String
  adminRoleId           String
  assignedByAdminUserId String?
  createdAt             DateTime @default(now())

  adminUser  AdminUser  @relation("RoleHolder", fields: [adminUserId], references: [id], onDelete: Cascade)
  adminRole  AdminRole  @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  assignedBy AdminUser? @relation("RoleAssigner", fields: [assignedByAdminUserId], references: [id])

  @@id([adminUserId, adminRoleId])
  @@index([adminRoleId])
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipHash       String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  // Timestamp at which this session was elevated by a successful TOTP /
  // recovery-code verification. Admin routes require this to be set when
  // the admin's `twoFactorRequired` flag is true.
  twoFactorAt  DateTime?

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuthChallenge {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String     @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserBan {
  id                          String     @id @default(cuid())
  userId                      String
  user                        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  banType                     BanType
  status                      BanStatus  @default(active)
  reasonCode                  ReasonCode
  internalNote                String?
  userFacingExplanation       String?
  bannedByAdminUserId         String
  bannedBy                    AdminUser  @relation("BanIssuer", fields: [bannedByAdminUserId], references: [id])
  bannedAt                    DateTime   @default(now())
  expiresAt                   DateTime?
  unbannedByAdminUserId       String?
  unbannedBy                  AdminUser? @relation("UnbanIssuer", fields: [unbannedByAdminUserId], references: [id])
  unbannedAt                  DateTime?
  unbanReason                 String?
  requireVerificationOnUnban  Boolean    @default(false)
  requireProfileReviewOnUnban Boolean    @default(false)

  appeals Appeal[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model ModerationAction {
  id                    String             @id @default(cuid())
  targetUserId          String?
  targetProfileId       String?
  targetPhotoId         String?
  targetMessageId       String?
  reportId              String?
  report                Report?            @relation(fields: [reportId], references: [id])
  actionType            ModerationDecision
  reasonCode            ReasonCode
  internalNote          String?
  userFacingExplanation String?
  createdByAdminUserId  String
  createdBy             AdminUser          @relation(fields: [createdByAdminUserId], references: [id])
  createdAt             DateTime           @default(now())

  @@index([targetUserId])
  @@index([reportId])
  @@index([createdAt])
}

model AdminNote {
  id                   String    @id @default(cuid())
  targetUserId         String?
  targetReportId       String?
  report               Report?   @relation(fields: [targetReportId], references: [id], onDelete: Cascade)
  body                 String
  createdByAdminUserId String
  createdBy            AdminUser @relation(fields: [createdByAdminUserId], references: [id])
  createdAt            DateTime  @default(now())
  editedAt             DateTime?

  @@index([targetUserId])
  @@index([targetReportId])
}

model SensitiveAccessGrant {
  id               String              @id @default(cuid())
  adminUserId      String
  adminUser        AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  targetEntityType SensitiveEntityType
  targetEntityId   String
  reason           AccessReasonCode
  note             String?
  reportId         String?
  createdAt        DateTime            @default(now())
  expiresAt        DateTime

  @@index([adminUserId, expiresAt])
  @@index([targetEntityType, targetEntityId])
}

model AdminAuditLog {
  id                     String            @id @default(cuid())
  adminUserId            String
  adminUser              AdminUser         @relation("AuditActor", fields: [adminUserId], references: [id])
  adminRoleSnapshot      String
  eventType              AdminEventType
  targetEntityType       String?
  targetEntityId         String?
  accessReason           AccessReasonCode?
  reportId               String?
  moderationActionId     String?
  sensitiveAccessGrantId String?
  requestId              String?
  ipHash                 String?
  userAgent              String?
  metadata               Json?
  createdAt              DateTime          @default(now())

  @@index([adminUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([targetEntityType, targetEntityId, createdAt])
}

model Appeal {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBanId            String
  userBan              UserBan      @relation(fields: [userBanId], references: [id], onDelete: Cascade)
  userExplanation      String
  status               AppealStatus @default(open)
  decidedByAdminUserId String?
  decidedBy            AdminUser?   @relation("AppealDecider", fields: [decidedByAdminUserId], references: [id])
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

// -------- Compliance: consents, DSARs, deletion, notifications --------

// Canonical versioned policy documents (ToS, Privacy Notice, etc.). Each
// ConsentRecord pins a (scope, version, text_hash) so we can prove what
// was shown to the user when they consented.
model PolicyDocument {
  id          String       @id @default(cuid())
  scope       ConsentScope
  version     String
  textHash    String
  effectiveAt DateTime
  publishedAt DateTime     @default(now())
  notes       String?

  consents ConsentRecord[]

  @@unique([scope, version])
  @@index([scope, effectiveAt])
}

model ConsentRecord {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            ConsentScope
  policyDocumentId String?
  policyDocument   PolicyDocument? @relation(fields: [policyDocumentId], references: [id])
  granted          Boolean
  policyVersion    String
  textHash         String
  collectedAt      DateTime        @default(now())
  withdrawnAt      DateTime?
  ipHash           String?
  userAgent        String?
  surface          String // "onboarding" | "settings" | "dsar" | "api" | …

  @@index([userId, scope])
  @@index([scope, collectedAt])
}

// Data Subject Access Request — covers GDPR, CCPA/CPRA, and equivalents.
// The full export bundle is staged in object storage; the row is the
// audit record + status pointer.
model DataSubjectRequest {
  id                   String          @id @default(cuid())
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestType          DsarRequestType
  status               DsarStatus      @default(received)
  channel              DsarChannel
  jurisdiction         String? // ISO-3166 alpha-2 of declared residency
  contactEmail         String?
  identityVerifiedAt   DateTime?
  receivedAt           DateTime        @default(now())
  dueAt                DateTime? // GDPR 30d / CCPA 45d default
  fulfilledAt          DateTime?
  refusalReason        String?
  exportStorageKey     String?
  exportBytes          Int?
  exportFormat         String? // "json+zip" default
  handledByAdminUserId String?
  notes                String?
  metadata             Json?

  @@index([userId, requestType])
  @@index([status, dueAt])
}

// Account deletion with a short grace period for accidental clicks.
// The deletion worker runs against the row, not against the user table.
model AccountDeletionRequest {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt       DateTime              @default(now())
  gracePeriodEndsAt DateTime
  cancelledAt       DateTime?
  startedAt         DateTime?
  leaseToken        String?
  completedAt       DateTime?
  // Final "irreversibly purged" timestamp written by the async worker
  // in backend/src/workers/deletion.ts. Distinct from completedAt to
  // preserve the prior path's semantics (completedAt was set when the
  // legacy in-line erasure finished). The new worker uses purgedAt +
  // status=purged.
  purgedAt          DateTime?
  status            AccountDeletionStatus @default(scheduled)
  reason            String?
  contactEmailHash  String? // so we can reach the user if they restore
  retainedDataNote  String?

  // One active request per user is enforced by a partial unique SQL index.
  @@index([userId, status])
  @@index([status, gracePeriodEndsAt])
  // PERF-B14 — daily-digest counts new deletion requests in a time window
  @@index([requestedAt])
}

model NotificationPreference {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Comms channels (transactional always on; these are *non-transactional*).
  productNewsEmail     Boolean   @default(false)
  productNewsPush      Boolean   @default(false)
  productNewsSms       Boolean   @default(false)
  // Functional categories (transactional, but user can mute push for some)
  newMatchPush         Boolean   @default(true)
  newMessagePush       Boolean   @default(true)
  newLikePush          Boolean   @default(true)
  safetyPush           Boolean   @default(true)
  // Preview policy for push payloads (privacy principle §7).
  pushPreviewMode      String    @default("sender_only") // "full" | "sender_only" | "hidden"
  // Marketing consent provenance for CASL/CAN-SPAM/TCPA.
  marketingOptInAt     DateTime?
  marketingOptOutAt    DateTime?
  marketingOptInSource String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// -------- Compliance: DSA notice-and-action, statement of reasons --------

// Reports from any party (user or non-user) under DSA Art. 16 / TAKE IT
// DOWN. Distinct from `Report` (user-to-user in-app) because:
//  - the reporter may not have an account,
//  - the category vocabulary is statutory,
//  - the workflow has its own SLA timer.
model NoticeAndActionReport {
  id                        String                  @id @default(cuid())
  category                  NoticeAndActionCategory
  status                    NoticeAndActionStatus   @default(received)
  reporterIsUser            Boolean                 @default(false)
  reporterUserId            String?
  reporterName              String?
  reporterEmail             String?
  reporterCountry           String?
  reporterIsTrustedFlagger  Boolean                 @default(false)
  trustedFlaggerId          String?
  trustedFlagger            TrustedFlagger?         @relation(fields: [trustedFlaggerId], references: [id])
  affectedUserId            String?
  affectedUser              User?                   @relation("NoticeAndActionTarget", fields: [affectedUserId], references: [id])
  contentReference          String // user_id / photo_id / message_id / URL
  contentSnapshot           Json? // tamper-evident snapshot at time of report
  description               String
  isInGoodFaith             Boolean                 @default(true)
  jurisdictionClaim         String? // member state, "EU", "global"
  legalBasisClaim           String? // e.g. "TAKE IT DOWN Act §1309"
  receivedAt                DateTime                @default(now())
  acknowledgedAt            DateTime?
  acknowledgedByAdminUserId String?
  respondedAt               DateTime?
  decidedByAdminUserId      String?
  slaDueAt                  DateTime? // legacy single-deadline (kept for back-compat)
  // DSA Art. 16 / TAKE IT DOWN Act SLA: acknowledgement and decision
  // each have their own deadline. Defaults populated by the service
  // when the notice is opened — Prisma can't express "createdAt + 24h"
  // as a column default, so we set them explicitly.
  slaAckDueAt               DateTime?
  slaDecisionDueAt          DateTime?
  slaAckBreachedAt          DateTime?
  slaDecisionBreachedAt     DateTime?
  resolvedAt                DateTime?
  decisionId                String?
  statementOfReasonsId      String?
  statementOfReasons        DsaStatementOfReasons?  @relation("NoticeStatementOfReasons", fields: [statementOfReasonsId], references: [id])
  metadata                  Json?

  @@index([status, slaDueAt])
  @@index([category, status])
  @@index([reporterUserId])
  @@index([affectedUserId])
  @@index([slaAckDueAt, acknowledgedAt])
  @@index([slaDecisionDueAt, respondedAt])
}

model TrustedFlagger {
  id            String    @id @default(cuid())
  name          String
  contactEmail  String
  jurisdiction  String?
  awardedAt     DateTime  @default(now())
  awardedBy     String // admin user id
  revokedAt     DateTime?
  revokedReason String?

  reports NoticeAndActionReport[]

  @@index([revokedAt])
}

// DSA Art. 17 statement of reasons; one per restriction action. Stored
// here in shape ready for submission to the DSA Transparency Database.
model DsaStatementOfReasons {
  id                          String    @id @default(cuid())
  affectedUserId              String?
  affectedContentReference    String
  restrictionType             String // "content_removed" | "visibility_restriction" | "account_suspension" | "monetary" | "service_termination"
  facts                       String
  legalGround                 String? // "illegal_content" | "tos_violation"
  legalGroundReference        String? // statute or ToS section
  contractualGround           String? // ToS section
  contentType                 String?
  contentLanguage             String?
  decisionSource              String // "user_report" | "trusted_flagger" | "authority_order" | "automated_detection" | "internal"
  automatedDecision           Boolean   @default(false)
  redressInternal             Boolean   @default(true)
  redressOutOfCourt           Boolean   @default(true)
  redressJudicial             Boolean   @default(true)
  sentToUserAt                DateTime?
  submittedToTransparencyDbAt DateTime?
  transparencyDbId            String? // ID from EC API
  metadata                    Json?
  createdAt                   DateTime  @default(now())

  noticesReferencing NoticeAndActionReport[] @relation("NoticeStatementOfReasons")

  @@index([affectedUserId])
  @@index([submittedToTransparencyDbAt])
}

// DSA Art. 21 out-of-court dispute settlement reference.
model OutOfCourtDispute {
  id                 String    @id @default(cuid())
  affectedUserId     String
  relatedDecisionId  String?
  relatedAppealId    String?
  body               String // certified body name
  filedAt            DateTime  @default(now())
  ourPositionFiledAt DateTime?
  outcome            String? // "in_user_favour" | "in_our_favour" | "withdrawn" | "ongoing"
  outcomeAt          DateTime?
  notes              String?

  @@index([affectedUserId])
  @@index([outcome])
}

// -------- Compliance: hash matching, NCMEC, scam signals --------

model HashSignal {
  id                    String     @id @default(cuid())
  targetPhotoId         String?
  targetUserId          String?
  hashAlgorithm         String // "pdq" | "photodna" | "md5" | "sha256"
  hashHex               String
  matchedList           HashList
  matchedListEntry      String? // vendor-specific identifier
  action                HashAction
  reviewedByAdminUserId String?
  reviewedAt            DateTime?
  createdAt             DateTime   @default(now())

  @@index([targetPhotoId])
  @@index([targetUserId])
  @@index([matchedList, action])
  @@index([hashAlgorithm, hashHex])
}

// Outgoing NCMEC CyberTipline reports (18 USC 2258A).
model NcmecReport {
  id                  String            @id @default(cuid())
  triggerHashSignalId String?
  affectedUserId      String?
  contentReference    String
  status              NcmecReportStatus @default(pending)
  submittedAt         DateTime?
  cybertiplineId      String? // assigned by NCMEC on receipt
  preservationEndsAt  DateTime? // 90-day preservation per §2258A(h)
  payload             Json // submission payload (sanitised)
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, submittedAt])
}

model ScamSignal {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ScamSignalKind
  score      Int            @default(0) // 0-100 rule output
  details    Json?
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?
  resolution String? // "ban_evasion" | "false_positive" | "warning_sent"

  @@index([userId, kind])
  @@index([kind, createdAt])
}

// Notification sent to a user that an account they recently communicated
// with was banned for fraud. Required by several US state online-dating
// safety statutes.
model ScammerNotification {
  id              String     @id @default(cuid())
  recipientUserId String
  recipient       User       @relation("ScammerNoticeRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  bannedUserHash  String // recipient never sees a useful identifier — opaque
  reasonCode      ReasonCode
  channel         String // "in_app" | "email"
  sentAt          DateTime   @default(now())
  readAt          DateTime?

  @@index([recipientUserId, sentAt])
}

// -------- Compliance: lawful process, sanctions --------

model LawEnforcementRequest {
  id                     String        @id @default(cuid())
  requesterAgency        String
  requesterCountry       String
  requestType            LERequestType
  externalRef            String?
  receivedAt             DateTime      @default(now())
  dueAt                  DateTime?
  status                 LEStatus      @default(received)
  affectedUserIds        String[]      @default([])
  notesPublic            String?
  notesInternal          String?
  notifiedUserAt         DateTime?
  notifiedUserSuppressed Boolean       @default(false)
  suppressedReason       String?
  producedContent        Boolean       @default(false)
  producedScope          String?
  closedAt               DateTime?

  @@index([status, dueAt])
  @@index([requesterCountry])
}

model SanctionsScreening {
  id           String                   @id @default(cuid())
  userId       String?
  user         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  countryCode  String? // ISO-3166 alpha-2
  result       SanctionsScreeningResult
  listsChecked String[]                 @default([]) // ["OFAC SDN", "EU consolidated", "UK OFSI"]
  matchDetails Json?
  screenedAt   DateTime                 @default(now())

  @@index([userId, screenedAt])
  @@index([result, screenedAt])
}

// -------- Beta launch: invite codes, feature flags, geo-fence --------

model BetaInviteCode {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  cohortLabel          String
  maxUses              Int                    @default(1)
  usedCount            Int                    @default(0)
  createdByAdminUserId String
  createdByAdmin       AdminUser              @relation(fields: [createdByAdminUserId], references: [id])
  expiresAt            DateTime?
  revokedAt            DateTime?
  notes                String?
  createdAt            DateTime               @default(now())
  redemptions          BetaInviteRedemption[]

  @@index([cohortLabel])
  @@index([revokedAt])
}

model BetaInviteRedemption {
  id           String         @id @default(cuid())
  inviteCodeId String
  inviteCode   BetaInviteCode @relation(fields: [inviteCodeId], references: [id])
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt   DateTime       @default(now())

  @@index([inviteCodeId])
}

model FeatureFlag {
  id                   String   @id @default(cuid())
  key                  String   @unique
  enabled              Boolean  @default(false)
  description          String
  variants             Json?
  updatedAt            DateTime @updatedAt
  updatedByAdminUserId String?
  createdAt            DateTime @default(now())

  @@index([key])
}

// Admin-curated catalog of selectable matching presets. Each row pins a
// ranking strategy (see @openmatch/matching strategy registry) and a set of
// weight overrides. End-users pick one via Preferences.discoveryPresetKey;
// admins manage the catalog (enable/disable, edit weights, set default).
// Mirrors the FeatureFlag conventions (key-addressed, audited, cached).
model MatchingPreset {
  id                   String   @id @default(cuid())
  key                  String   @unique
  label                String
  description          String
  strategyId           String
  // Partial RankingWeights overlay, e.g. { "distance": 0.45 }. Validated
  // against the known weight keys at the route layer; normalized to sum to 1
  // by the matching package at resolve time.
  weights              Json
  enabled              Boolean  @default(true)
  isDefault            Boolean  @default(false)
  sortOrder            Int      @default(0)
  updatedAt            DateTime @updatedAt
  updatedByAdminUserId String?
  createdAt            DateTime @default(now())

  @@index([enabled])
}

model MetroBoundary {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  centerLat   Float
  centerLng   Float
  radiusKm    Float
  countryCode String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model NotificationDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  token      String
  appVersion String?
  osVersion  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  eventName  String
  properties Json?
  clientTs   DateTime?
  serverTs   DateTime  @default(now())
  appVersion String?
  osVersion  String?

  @@index([eventName, serverTs])
  @@index([userId, serverTs])
  // PERF-B15 — alerter counts total events in a window (no eventName prefix)
  @@index([serverTs])
}

model BetaFeedback {
  id                    String    @id @default(cuid())
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category              String
  body                  String
  appVersion            String?
  osVersion             String?
  deviceModel           String?
  resolvedAt            DateTime?
  resolvedByAdminUserId String?
  createdAt             DateTime  @default(now())

  @@index([resolvedAt])
  @@index([userId])
}

// OPS-1: APNs delivery log. One row per push send attempt — successes
// and failures both — so the retry worker can find recent failures and
// the admin dashboard can answer "is push working right now?".
model PushDeliveryLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String?
  category      String // "match" | "message" | "like" | "safety"
  success       Boolean
  failureReason String?
  sentAt        DateTime @default(now())

  @@index([userId, sentAt])
  @@index([category, sentAt])
  @@index([success, sentAt])
}

// MON-2: on-call alert dedupe. Each alert kind plus its target id forms
// `alertKey`. While `resolvedAt` is null, the same alert is treated as
// already firing and won't re-page.
model AlertFired {
  id         String    @id @default(cuid())
  alertKey   String
  firedAt    DateTime  @default(now())
  resolvedAt DateTime?
  details    Json?

  @@index([alertKey, firedAt])
  @@index([alertKey, resolvedAt])
}

// BETA-3: out-of-cohort interest capture. Public endpoint, rate-limited,
// stores only the SHA-256 hash of email (via `hashIdentity`) so the row
// is GDPR-friendly and idempotent on repeated submissions.
model WaitlistEntry {
  id        String   @id @default(cuid())
  emailHash String   @unique
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([country])
  @@index([createdAt])
}

// PLATFORM-PLUGIN — paid-tier entitlements granted to a user by an
// authoritative billing source. Populated by `POST /api/v1/iap/validate`
// after the configured `BillingProvider` accepts a receipt; consumed by
// downstream code that gates paywalled features. Storing the source
// keeps the audit trail honest when multiple providers coexist (e.g.
// Apple StoreKit on iOS, a fork-specific Stripe path on web).
model Entitlement {
  id            String    @id @default(cuid())
  userId        String
  productId     String
  expiresAt     DateTime?
  source        String // e.g. "apple", "google", "stripe"
  transactionId String? // provider's transaction id for dedupe
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, expiresAt])
  @@unique([source, transactionId])
}

// Round D — synthetic check audit trail. Each cron-invoked run of the
// synthetic probe writes a row so the admin "Health" panel can render
// the last N results and ops can answer "when did the synthetic last
// pass?" without scraping logs.
model SyntheticCheckRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  durationMs Int
  passed     Boolean
  steps      Json // [{ name, passed, error? }]

  @@index([ranAt])
}

// Status-page incident timeline. Admin operators post updates from the
// admin dashboard; the public /status page renders the active update
// (if any) plus the last 7 days of resolved updates. Each update is
// append-only — to "resolve" an incident, post a new update with
// status=resolved. The most recent row per `incidentKey` is the
// authoritative current state; older rows form the human-readable
// timeline ("Identified" → "Monitoring" → "Resolved").
enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

enum IncidentSeverity {
  none // informational / maintenance notice
  minor // degraded but most users unaffected
  major // significant user-visible impact
  critical // platform unavailable for most users
}

model IncidentUpdate {
  id          String           @id @default(cuid())
  // Logical incident grouping. Multiple updates share an incidentKey
  // as they progress through investigating → identified → monitoring →
  // resolved. The first update of a new incident generates a fresh
  // cuid() that subsequent updates reuse.
  incidentKey String
  title       String
  body        String           @db.Text
  status      IncidentStatus
  severity    IncidentSeverity @default(minor)
  // Which service this update pertains to. Free-form string so we can
  // add new services (e.g. "search" later) without a migration.
  service     String           @default("backend")
  postedAt    DateTime         @default(now())
  postedBy    String? // AdminUser.id; nullable for system-posted updates

  @@index([incidentKey, postedAt])
  @@index([postedAt])
  @@index([status, postedAt])
}

// Trust & safety automation — user-initiated verification challenge.
// The selfie-pose flow is the only kind implemented end-to-end today,
// but the model accommodates phone + ID verification scaffolds so the
// admin queue UI can grow into a single review surface.
model VerificationRequest {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                VerificationRequestKind   @default(selfie_pose)
  status              VerificationRequestStatus @default(pending)
  // Free-form description of the challenge ("hold up 2 fingers and
  // look right"). Stored verbatim so a reviewer can compare it against
  // the captured image without trusting the iOS client.
  challengePrompt     String
  // Server-generated nonce that pins the (user, prompt) pair to the
  // photo. Prevents replay of an older capture.
  challengeNonce      String                    @unique
  imageStorageKey     String?
  imageContentType    String?
  imageBytes          Int?
  reviewerAdminUserId String?
  reviewedAt          DateTime?
  decisionNote        String?
  // Provider hint for phone / id verification stubs. Always null for
  // the selfie-pose path today.
  provider            String?
  providerExternalRef String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([kind, status])
}

// Trust & safety automation — every heuristic moderator output, even
// the "allow" ones we don't act on, lands here so operators can see
// false-positive rates and tune thresholds. A `decision` of `block`
// indicates the content was rejected outright (the message / bio is
// not persisted); `flag` means the content shipped but is queued for
// admin review.
model ModerationFlag {
  id                    String                 @id @default(cuid())
  targetUserId          String
  targetUser            User                   @relation("ModerationFlagTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  surface               ModerationSurface
  decision              ModerationDecisionKind
  // Stable code emitted by the heuristic moderator
  // (`url_in_message`, `phone_in_bio`, `crypto_keyword`, etc.). Tests
  // and tuning queries select on this string.
  reasonCode            String
  // The actual text fragment that fired the rule, redacted to 240
  // chars so an operator can adjudicate without storing arbitrary
  // pasted secrets.
  excerpt               String?
  // Provider identifier — `heuristic` today; the interface is wired
  // for `hive`, `sightengine`, `rekognition` etc. once an operator
  // configures one.
  provider              String                 @default("heuristic")
  // Free-form details bag — e.g. the regex source, signal score,
  // sample match offset.
  details               Json?
  // Foreign references — both nullable so a row can attach to whatever
  // surface fired the rule.
  targetMessageId       String?
  targetProfileId       String?
  // Set by the admin when they triage the flagged content.
  resolvedAt            DateTime?
  resolvedByAdminUserId String?
  resolution            String?
  createdAt             DateTime               @default(now())

  @@index([targetUserId, createdAt])
  @@index([surface, decision, createdAt])
  @@index([resolvedAt])
}
