# OpenMatch backend — local development configuration.
# Copy this file to .env and adjust as needed.

# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Database (Postgres + PostGIS via docker-compose)
DATABASE_URL=postgresql://openmatch:openmatch@localhost:5432/openmatch?schema=public

# Redis (cache, rate limits)
REDIS_URL=redis://localhost:6379

# JWT (use a real long random string in production; this is dev-only).
# All *_SECRET / *_TOKEN / *_KEK env vars MUST be >=32 bytes (the Zod
# schema in src/env.ts rejects anything shorter). Generate with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-please-replace-32b
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Admin BFF JWT secret. Required in every non-test environment — no
# default. Generate independently from JWT_SECRET so a leaked consumer
# secret cannot mint admin tokens.
ADMIN_JWT_SECRET=dev-admin-only-secret-change-me-in-production-32b

# Internal cron / worker bearer. Required for /api/v1/internal/* routes.
# Rotate independently from CRON_SECRET so the cron secret can change
# without breaking manual ops invocations.
INTERNAL_WORKER_TOKEN=dev-internal-worker-only-token-change-in-prod-32b

# TOTP envelope-encryption KEK. Optional in dev (we fall back to
# plaintext storage with a console warning); REQUIRED in production
# before AdminUser.totpSecret values can be encrypted at rest.
# Generate with: openssl rand -hex 32
# ADMIN_TOTP_KEK=

# Identity-hash HMAC salt. Optional; when absent we fall back to plain
# SHA-256 (legacy behaviour). When set, hashIdentity() switches to
# HMAC-SHA256(secret, value) so a leaked emailHash cannot be confirmed
# from an email guess without the secret.
# IDENTITY_HASH_SECRET=

# Email magic-link (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@openmatch.local
MAGIC_LINK_TTL_SECONDS=900

# Apple Sign-In
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# GCS for photos (leave empty to use local filesystem fallback)
GCS_BUCKET=
GCS_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Frontend / CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Dev login (creates a backdoor test login; never set in production)
ALLOW_DEV_LOGIN=true
