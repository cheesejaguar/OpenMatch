/* ErrorMessages.strings
 *
 * User-facing copy for every APIError case. Keys mirror the backend
 * error codes registry in backend/src/lib/error-codes.ts. The iOS
 * `APIError.errorDescription` getter looks up "error.<code>" here.
 *
 * Format specifiers:
 *   - %.1f / %f — outside_metro uses %.1f for the nearest distance in km.
 *   - %@ / %1$@, %2$@ — country_not_supported can interpolate a reason.
 *   - http uses %1$d for status and %2$@ for the optional body string.
 */

