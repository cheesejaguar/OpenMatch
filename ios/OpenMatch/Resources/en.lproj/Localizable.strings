// MARK: - Formatters (not user-facing strings but format keys)
//
// We never compose these manually — use `MeasurementFormatter`,
// `Date.formatted(date:time:)`, and `NumberFormatter` so locale picks
// the right pattern. Keys here are only for tests that assert on
// formatted output (e.g. "1.2 km" vs "1.2 km" with locale-correct
// separators).

"format.distance.km"                       = "%.1f km";
"format.distance.mi"                       = "%.1f mi";
"format.age"                               = "%lld";
