{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -w @openmatch/matching && npm exec --workspace=@openmatch/backend -- prisma generate && npm run build -w @openmatch/backend",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{backend/dist/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/v1/internal/run-deletion-purge", "schedule": "*/15 * * * *" },
    { "path": "/api/v1/internal/run-dsa-sla-check", "schedule": "0 * * * *" },
    { "path": "/api/v1/internal/run-push-retry", "schedule": "*/5 * * * *" },
    { "path": "/api/v1/internal/run-alert-check", "schedule": "*/5 * * * *" },
    { "path": "/api/v1/internal/run-daily-digest", "schedule": "0 16 * * *" },
    { "path": "/api/v1/internal/run-synthetic-check", "schedule": "*/5 * * * *" },
    { "path": "/api/v1/internal/run-synthetic-prune", "schedule": "0 4 * * *" }
  ]
}
